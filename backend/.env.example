# Local development settings (read from backend/.env). All values are optional.
ENVIRONMENT=development
# Default is SQLite (backend/saap.db). For MySQL:
# DATABASE_URL=mysql+pymysql://saap:password@127.0.0.1:3306/saap?charset=utf8mb4
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
